# Copy to .env and fill in. .env is gitignored — keep it that way.
# On Windows, create it from a terminal: Copy-Item .env.example .env
# (Explorer will not let you name a file starting with a dot, and Notepad
# silently appends .txt — check with `dir` if the runner says the key is unset.)

# --- Required for a real deliberation (turn 003 onward) ---

OPENROUTER_API_KEY=

# The per-role allocation is COMMITTED IN CODE, in modelMap() in src/config.js,
# and there is no environment variable that sets it. It is a project decision
# with a record behind it (docs/decisions/0009), not a local setting: a
# deployment that quietly ran a different allocation would make every stored run
# uninterpretable.
#
# This variable is the control condition only. Set it to one model slug and all
# seven roles use that model, which is how the conditions in turn 010 were
# measured. Leave it empty for normal runs. Any slug here must support
# structured / JSON output — every prompt demands one JSON object, and a model
# that cannot produce it fails all seven calls at gate G2.
#
# (TRIBUNAL_MODEL, which set every role before turn 010, is no longer read. The
# runner says so on startup if it is still in your .env.)
TRIBUNAL_UNIFORM_MODEL=

# Hard cap per deliberation. A run that exceeds it aborts. This protects against
# a retry loop inside one run; set a credit limit on the OpenRouter key itself
# to protect against everything else.
MAX_CALLS_PER_DELIBERATION=10

# --- Supabase (turn 006). Optional: without these the run is kept locally only. ---

# Run db/schema.sql once in the Supabase SQL editor before setting these.
SUPABASE_URL=

# The SECRET key — `sb_secret_...`, from Settings > API Keys, the "API Keys"
# tab, not "Legacy API Keys". The legacy JWT pair (anon / service_role) is
# being deprecated by the end of 2026. This key bypasses row-level security:
# backend only, never in a browser bundle.
SUPABASE_SECRET_KEY=
